#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectroot = dirname(__DIR__);
if (is_file($projectroot . '/vendor/autoload.php')) {
    require $projectroot . '/vendor/autoload.php';
} else {
    require $projectroot . '/autoload.php';
}

use EduardoKraus\MoodleStringValidate\Validator;

function usage(): void {
    echo <<<TXT
Moodle String Validate

Usage:
  moodle-string-validate [plugin-path] [--lang=en] [--format=text|github] [--allow-empty]

Examples:
  moodle-string-validate .
  moodle-string-validate ./plugin --format=github

Exit codes:
  0  No validation errors (warnings do not fail the command)
  1  Validation errors found
  2  Invalid arguments or runtime error
TXT;
}

function githubEscape(string $value): string {
    return str_replace(["%", "\r", "\n", ":", ","], ["%25", "%0D", "%0A", "%3A", "%2C"], $value);
}

$path = '.';
$language = 'en';
$format = 'text';
$checkempty = true;
$pathset = false;

foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--help' || $argument === '-h') {
        usage();
        exit(0);
    }
    if ($argument === '--allow-empty') {
        $checkempty = false;
        continue;
    }
    if (str_starts_with($argument, '--lang=')) {
        $language = substr($argument, strlen('--lang='));
        continue;
    }
    if (str_starts_with($argument, '--format=')) {
        $format = substr($argument, strlen('--format='));
        continue;
    }
    if (str_starts_with($argument, '-')) {
        fwrite(STDERR, "Unknown option: {$argument}\n");
        exit(2);
    }
    if ($pathset) {
        fwrite(STDERR, "Only one plugin path may be supplied.\n");
        exit(2);
    }
    $path = $argument;
    $pathset = true;
}

if (!in_array($format, ['text', 'github'], true)) {
    fwrite(STDERR, "Invalid format '{$format}'. Use text or github.\n");
    exit(2);
}

try {
    $checks = (new Validator())->validateDetailed($path, $language, $checkempty);
} catch (Throwable $exception) {
    fwrite(STDERR, 'ERROR: ' . $exception->getMessage() . PHP_EOL);
    exit(2);
}

$errorcount = 0;
$warningcount = 0;
$okcount = 0;

if ($format === 'text') {
    echo "Moodle String Validate\n";
    echo str_repeat('=', 22) . "\n\n";
}

foreach ($checks as $check) {
    if ($check->isWarning()) {
        $warningcount++;
        if ($format === 'github') {
            echo "WARNING [{$check->rule}] {$check->file}:{$check->line}\n";
            echo '::warning file=' . githubEscape($check->file) . ',line=' . $check->line . ',title=Moodle validate ' . githubEscape($check->rule) . '::' . githubEscape($check->message) . "\n";
        } else {
            echo "WARNING [{$check->rule}] {$check->file}:{$check->line}\n";
            echo "  {$check->message}\n";
        }
        continue;
    }

    if (!$check->isError()) {
        $okcount++;
        if ($check->key !== '') {
            echo "OK [{$check->rule}] \$string['{$check->key}']\n";
        } else {
            echo "OK [{$check->rule}] {$check->message}\n";
        }
        continue;
    }

    $errorcount++;
    if ($format === 'github') {
        $message = githubEscape($check->message);
        $file = githubEscape($check->file);
        $target = $check->key !== '' ? "\$string['{$check->key}']" : $check->file;
        echo "ERROR [{$check->rule}] {$target}\n";
        echo "::error file={$file},line={$check->line},title=Moodle validate {$check->rule}::{$message}\n";
        continue;
    }

    echo "ERROR [{$check->rule}] {$check->file}:{$check->line}\n";
    echo "  {$check->message}\n";
}

if ($format === 'text') {
    echo "\n{$okcount} OK, {$warningcount} warning" . ($warningcount === 1 ? '' : 's') . ", {$errorcount} error" . ($errorcount === 1 ? '' : 's') . ".\n";
}

exit($errorcount === 0 ? 0 : 1);
