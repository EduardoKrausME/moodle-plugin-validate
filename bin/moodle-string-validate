#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectroot = dirname(__DIR__);
if (is_file($projectroot . '/vendor/autoload.php')) {
    require $projectroot . '/vendor/autoload.php';
} else {
    require $projectroot . '/autoload.php';
}

use EduardoKraus\MoodleStringValidate\Validator;

function usage(): void {
    echo <<<TXT
Moodle Plugin Validate

Usage:
  moodle-string-validate [plugin-path] [--lang=en] [--format=text|github|json] [--allow-empty]

Examples:
  moodle-string-validate .
  moodle-string-validate ./plugin --format=github
  moodle-string-validate ./plugin --format=json

Exit codes:
  0  No validation errors (warnings do not fail the command)
  1  Validation errors found
  2  Invalid arguments or runtime error
TXT;
}

function githubEscape(string $value): string {
    return str_replace(["%", "\r", "\n", ":", ","], ["%25", "%0D", "%0A", "%3A", "%2C"], $value);
}

function githubFileUrl(string $pluginpath, string $file, int $line): ?string {
    $serverurl = getenv('GITHUB_SERVER_URL');
    $repository = getenv('GITHUB_REPOSITORY');
    $sha = getenv('GITHUB_SHA');
    $workspace = getenv('GITHUB_WORKSPACE');

    if (!$serverurl || !$repository || !$sha || !$workspace) {
        return null;
    }

    $pluginroot = realpath($pluginpath);
    $workspaceroot = realpath($workspace);
    if ($pluginroot === false || $workspaceroot === false) {
        return null;
    }

    $filepath = str_replace(
        '\\',
        '/',
        rtrim($pluginroot, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . ltrim($file, '/\\'),
    );
    $workspaceprefix = rtrim(str_replace('\\', '/', $workspaceroot), '/') . '/';
    if (!str_starts_with($filepath, $workspaceprefix)) {
        return null;
    }

    $relative = substr($filepath, strlen($workspaceprefix));
    $encodedpath = implode('/', array_map('rawurlencode', explode('/', $relative)));

    return rtrim($serverurl, '/')
        . '/' . $repository
        . '/blob/' . rawurlencode($sha)
        . '/' . $encodedpath
        . '#L' . $line;
}

/**
 * @param array<string, mixed> $payload
 */
function outputJson(array $payload): void {
    echo json_encode(
        $payload,
        JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR
    ) . PHP_EOL;
}

$path = '.';
$language = 'en';
$format = 'text';
$checkempty = true;
$pathset = false;

foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--help' || $argument === '-h') {
        usage();
        exit(0);
    }
    if ($argument === '--allow-empty') {
        $checkempty = false;
        continue;
    }
    if (str_starts_with($argument, '--lang=')) {
        $language = substr($argument, strlen('--lang='));
        continue;
    }
    if (str_starts_with($argument, '--format=')) {
        $format = substr($argument, strlen('--format='));
        continue;
    }
    if (str_starts_with($argument, '-')) {
        fwrite(STDERR, "Unknown option: {$argument}\n");
        exit(2);
    }
    if ($pathset) {
        fwrite(STDERR, "Only one plugin path may be supplied.\n");
        exit(2);
    }
    $path = $argument;
    $pathset = true;
}

if (!in_array($format, ['text', 'github', 'json'], true)) {
    fwrite(STDERR, "Invalid format '{$format}'. Use text, github or json.\n");
    exit(2);
}

try {
    $result = (new Validator())->validateResult($path, $language, $checkempty);
    $data = $result->toArray();
} catch (Throwable $exception) {
    if ($format === 'json') {
        outputJson([
            'schema' => 1,
            'success' => false,
            'status' => 'error',
            'summary' => [
                'total' => 0,
                'ok' => 0,
                'warnings' => 0,
                'errors' => 1,
            ],
            'groups' => [],
            'runtimeError' => [
                'message' => $exception->getMessage(),
            ],
        ]);
    } else {
        fwrite(STDERR, 'ERROR: ' . $exception->getMessage() . PHP_EOL);
    }
    exit(2);
}

if ($format === 'json') {
    outputJson($data);
    exit($data['success'] ? 0 : 1);
}

$errorcount = $data['summary']['errors'];
$warningcount = $data['summary']['warnings'];
$okcount = $data['summary']['ok'];

if ($format === 'text') {
    echo "Moodle Plugin Validate\n";
    echo str_repeat('=', 22) . "\n\n";
}

foreach ($data['groups'] as $group) {
    echo "## {$group['rule']}\n";

    foreach ($group['checks'] as $check) {
        if ($check['status'] === 'warning') {
            if ($format === 'github') {
                echo "  ▶ WARNING {$check['file']}:{$check['line']}\n";
                echo '::warning file=' . githubEscape($check['file'])
                    . ',line=' . $check['line']
                    . ',title=Moodle validate ' . githubEscape($group['rule'])
                    . '::' . githubEscape($check['message']) . "\n";
            } else {
                echo "  ▶ WARNING {$check['file']}:{$check['line']}\n";
                echo "    {$check['message']}\n";
            }
            continue;
        }

        if ($check['status'] === 'ok') {
            // The successful pluginname check is represented by the rule heading itself.
            if ($group['rule'] === 'pluginname' && $check['languageString'] && $check['key'] === 'pluginname') {
                continue;
            }

            if ($check['key'] !== '') {
                echo "  ▶ OK {$check['target']}\n";
            } else {
                echo "  ▶ OK {$check['message']}\n";
            }
            continue;
        }

        if ($format === 'github') {
            echo "  ▶ ERROR {$check['target']}\n";
            $fileurl = githubFileUrl($path, $check['file'], $check['line']);
            if ($fileurl !== null) {
                echo "    File: {$fileurl}\n";
            }
            echo '::error file=' . githubEscape($check['file'])
                . ',line=' . $check['line']
                . ',title=Moodle validate ' . githubEscape($group['rule'])
                . '::' . githubEscape($check['message']) . "\n";
            continue;
        }

        echo "  ▶ ERROR {$check['file']}:{$check['line']}\n";
        echo "    {$check['message']}\n";
    }

    echo PHP_EOL;
}

if ($format === 'text') {
    echo "{$okcount} OK, {$warningcount} warning" . ($warningcount === 1 ? '' : 's')
        . ", {$errorcount} error" . ($errorcount === 1 ? '' : 's') . ".\n";
}

exit($data['success'] ? 0 : 1);
